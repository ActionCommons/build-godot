{
  "name": "build-godot",
  "description": "GitHub Action to download and build the Godot game engine from source",
  "version": "1.2.0",
  "author": "Action Commons (https://github.com/ActionCommons)",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/ActionCommons/build-godot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ActionCommons/build-godot.git"
  },
  "bugs": {
    "url": "https://github.com/ActionCommons/build-godot/issues"
  },
  "keywords": [
    "actions",
    "github-actions",
    "godot",
    "godot-engine",
    "build",
    "scons"
  ],
  "exports": {
    ".": "./dist/index.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "test:mutation": "npx stryker run",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@types/adm-zip": "^0.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.3",
    "ts-jest": "^29.4.15",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "undici": "~6.29.1"
  }
}
